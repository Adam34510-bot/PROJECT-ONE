# Copiez ce fichier en ".env" puis renseignez vos valeurs (en ligne : mêmes noms dans Vercel ou Netlify).
# Le fichier .env ne doit jamais être publié : il est déjà exclu de Git.

# ---------------------------------------------------------------- IA (côté serveur uniquement)
# Clé API Anthropic (console.anthropic.com > API Keys). Jamais envoyée au navigateur.
# Sans clé, l'assistant fonctionne en mode démonstration, signalé comme tel.
ANTHROPIC_API_KEY=

# Modèle utilisé. Par défaut : claude-opus-5-5 (le plus capable).
# Moins cher et plus rapide : claude-sonnet-5-5 ou claude-haiku-5-5 (conseillé sur Netlify, limité à 10 s par réponse).
AI_MODEL=claude-opus-5-5

# Nombre de messages IA autorisés par utilisateur et par jour (protège votre crédit).
AI_DAILY_LIMIT=50

# Délai maximal d'attente de l'IA en millisecondes (défaut 55000). Sur Netlify gratuit : 9000.
# AI_TIMEOUT_MS=55000

# ---------------------------------------------------------------- Comptes et sauvegarde (Supabase)
# Supabase > Project Settings > API : "Project URL" et clé "anon public".
# Cette clé est publique par conception : la base est protégée par les règles de supabase/schema.sql.
# Quand ces deux valeurs sont présentes, la connexion devient obligatoire pour utiliser l'IA.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- Support (facultatif)
# Adresse qui reçoit les demandes des personnes sans compte (via leur messagerie).
VITE_SUPPORT_EMAIL=
